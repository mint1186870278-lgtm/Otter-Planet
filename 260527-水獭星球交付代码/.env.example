# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_CHAT_RELAY_URL: NPC 对话 / 月亮向导讲故事的【后端中转】端点（后端提供后填入）。
# 前端向此地址 POST { messages }（不带 key）；后端补 key 调 StepFun，并把 SSE 流式响应原样透传回来。
# 🔒 安全：前端不再持有 StepFun key，key 只在后端。留空则用占位 /api/chat（中转没好时对话走友好兜底）。
VITE_CHAT_RELAY_URL=""

# FISH_AUDIO_API_KEY: Fish Audio 服务端 API Key。只放在 .env / 服务器环境变量里，不能以 VITE_ 前缀暴露到前端。
FISH_AUDIO_API_KEY="MY_FISH_AUDIO_API_KEY"

# FISH_AUDIO_MODEL: Fish Audio TTS model header，默认 s2-pro。
FISH_AUDIO_MODEL="s2-pro"

# VITE_FISH_TTS_RELAY_URL: Fish Audio 配音中转端点。留空则用 /api/fish-tts。
VITE_FISH_TTS_RELAY_URL=""

# VITE_IMAGE_RELAY_URL: 探险相册生图的【后端中转】端点（后端提供后填入）。
# 前端向此地址 POST { prompt, image, size }（不带 key）；后端补 key + 固定参数调火山方舟，返回 { url }。
# 🔒 安全：前端不再持有火山方舟 key，key 只在后端。留空则用占位 /api/image-gen。
VITE_IMAGE_RELAY_URL=""

# VITE_EGG_SUBMIT_URL: 水獭蛋留存页的邮箱/微信提交端点（后端提供后填入）。
# 前端会向此地址 POST { email|wechat, lang, source:"otter-egg", ts }。留空则用占位 /api/otter-egg。
VITE_EGG_SUBMIT_URL=""

# VITE_EGG_DEMO: 演示开关。=true 时邮箱提交跳过真实请求、直接走成功态（后端端点没好也能完整演示）。
# 上线 / 后端 ready 后改成 false（或删除），并填好 VITE_EGG_SUBMIT_URL。
VITE_EGG_DEMO="true"

# VITE_TRACK_URL: 埋点数据上报端点（后端提供后填入）。
# 前端会向此地址 POST 行为事件 { sessionId, event, ...payload, ts }（含匿名 sessionId，不含任何隐私内容）。
# 留空则用占位 /api/track。
VITE_TRACK_URL=""

# VITE_TRACK_DEMO: 埋点演示开关。=true 时 track() 只在控制台 console.log、不真发请求（演示/本地调试用）。
# 上线 / 后端 ready 后改成 false（或删除），并填好 VITE_TRACK_URL。
VITE_TRACK_DEMO="true"

# VITE_OTTERLANTIS_ASSET_ORIGIN: Optional CDN/object-storage origin for public runtime assets.
# Leave empty to load from the same host. Example: https://cdn.otterlantis.com
VITE_OTTERLANTIS_ASSET_ORIGIN=""
